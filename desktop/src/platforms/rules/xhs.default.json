  },
  "api_paths": {
    "user_info": "/api/galaxy/user/info",
    "posted_notes": "/api/galaxy/v2/creator/note/user/posted",
    "personal_info": "/api/galaxy/creator/home/personal_info",
    "comment_page": "/api/sns/web/v2/comment/page"
  },
  "share_hosts": [
    "xhslink.com",

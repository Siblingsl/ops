{
  "manifest_version": 3,
  "name": "OPS Browser Bridge",
  "version": "0.1.0",
  "description": "OPS 桌面与本机 Chrome 的受控桥接（DEV-AI27-02 技术验证）。仅执行包内登记动作，不执行任意脚本。",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "OPS Browser Bridge"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}

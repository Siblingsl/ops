# 复制为 .env 后填写；权限建议 chmod 600 .env
# 公众号 AppSecret / 模型密钥不要写这里，上线后在网页设置里录入

OPS_DOMAIN=ops.88813888.xyz
OPS_PUBLIC_IP=120.27.20.115

# 生成：openssl rand -base64 32
OPS_MASTER_KEY=

# 生成：openssl rand -base64 24
POSTGRES_PASSWORD=

# 纯 HTTP 访问时保持 0；按 https-setup.md 启用全站 HTTPS 后改为 1
OPS_COOKIE_SECURE=0

# 每个工作区同时运行的后台与流式 AI 任务数（1-32，默认 3）
# OPS_AI_WORKERS=3

# 业务数据库最大连接数（正整数，默认 20；每个应用实例分别计算）
# OPS_DB_MAX_CONNS=20

# V4 采集部署开关；off 为默认。改为 allow 后，仍需超管在网页开启来源和强度。
# 小红书与公众号页面受 robots 限制，保持停用；不影响官方微信接口。
OPS_CRAWL_MODE=off

# 永久超级管理员（D-044）；启动时自动创建/对齐，不可撤销
# 密码只从这里读取：不设置则不创建该账号（已存在的账号保留原密码）
# OPS_SYSTEM_ADMIN_USER=skyeder
OPS_SYSTEM_ADMIN_PASSWORD=

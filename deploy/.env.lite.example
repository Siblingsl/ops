# =============================================================================
# OPS 轻量生产环境变量模板（个人 + 2–10 人小团队，2C2G 单机）
# =============================================================================
# 一键用法（在仓库根执行）：
#   cp deploy/.env.lite.example deploy/.env.lite
#   chmod 600 deploy/.env.lite
#   # 打开 deploy/.env.lite，把下面「一、必改 5 项」的 CHANGE_ME / 示例值全部替换：
#   docker compose -f deploy/docker-compose.lite.yml --env-file deploy/.env.lite up -d --build
#   docker compose -f deploy/docker-compose.lite.yml --env-file deploy/.env.lite ps
#
# 启动前可先做语法与环境变量自检（不会真正启动容器）：
#   docker compose -f deploy/docker-compose.lite.yml --env-file deploy/.env.lite config -q
#
# 注意：
# 1. 本文件里的 CHANGE_ME_*、203.0.113.10、ops-api.example.com 全部是脱敏占位符，
#    直接拿去上线等于用公开示例值当密码，必须逐条替换。
# 2. 公众号 AppSecret 与模型 API Key 不要写在这里；首次登录后在桌面端「设置」页录入。
# 3. 绝不能在本文件或宿主环境配置 HTTP_PROXY / HTTPS_PROXY：
#    微信出站必须走服务器直连出口（固定出口 IP / 公众号 IP 白名单依赖直连 IP），
#    写入代理变量会让出站 IP 静默漂移、白名单失效；编排文件已显式置空。

# -----------------------------------------------------------------------------
# 一、必改 5 项（缺一项都不要启动）
# -----------------------------------------------------------------------------

# 1) 业务数据库密码（postgres 容器与应用连接串共用）
#    生成：openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# 2) 应用主密钥：用于加密工作区密钥等敏感字段，上线后不要随意更换（换掉旧密文无法解密）
#    生成：openssl rand -base64 32
OPS_MASTER_KEY=CHANGE_ME_OPS_MASTER_KEY

# 3) 服务器固定公网 IP（NFR-02）：微信公众平台「IP 白名单」要填这个出口 IP。
#    必须是这台机器实际对外的固定 IPv4；下面只是 RFC 5737 文档示例地址。
OPS_PUBLIC_IP=203.0.113.10

# 4) 永久超级管理员密码（D-044）：首次启动自动创建账号，之后每次启动按此值对齐密码。
#    不要留空：留空则不创建该账号（已存在的账号保留原密码）。
#    生成：openssl rand -base64 18
OPS_SYSTEM_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# 5) 跨源白名单：默认只放行打包桌面端的安全自定义协议，不要图省事写 * 或 http://localhost。
#    需要额外来源时用英文逗号追加，例如 ops-desktop://business,https://ops-api.example.com
OPS_CORS_ORIGINS=ops-desktop://business

# -----------------------------------------------------------------------------
# 二、可选高级开关（不改也能跑；括号内为默认值）
# -----------------------------------------------------------------------------

# —— 域名 / 端口 / 镜像 ——
# 服务器本身不读 OPS_DOMAIN，它给宿主机 Nginx 与 Cloudflare 配置文档用；
# 纯 IP 访问可留空。示例域名是 RFC 2606 保留域名 ops-api.example.com。
# OPS_DOMAIN=ops-api.example.com
#
# 宿主机反代要连的本机端口（默认 44537，只绑 127.0.0.1）。
# 改这里之后，Nginx/Caddy 的 upstream 也要同步改。
OPS_HOST_PORT=44537
#
# 镜像名：默认本地构建 ops-app:local；用私有仓库时可改成 registry/ops:tag。
# OPS_IMAGE=ops-app:local

# —— Cookie 与反向代理 ——
# 桌面端通过 HTTPS 访问 API，必须 Secure Cookie（默认 1）。纯 HTTP 内网调试才设 0。
OPS_COOKIE_SECURE=1
#
# 桌面端从 ops-desktop://business 跨站请求，需要 SameSite=None + Secure（默认 none）。
OPS_COOKIE_SAMESITE=none
#
# 可信反代网段（逗号分隔 CIDR）。宿主 Nginx -> 127.0.0.1:44537 -> 容器时，
# 容器看到的直连对端是 Docker 网关，默认 172.16.0.0/12 即适用；
# 直接跑二进制且 Nginx 同机时改为 127.0.0.1/32。
OPS_TRUSTED_PROXIES=172.16.0.0/12

# —— 2C2G 轻量并发 ——
# 每个工作区同时运行的后台/流式 AI 任务数（1–32）。2C2G 建议 2，别按大机器填 8。
OPS_AI_WORKERS=2
#
# 业务数据库最大连接数（正整数，每实例分别计算）。2C2G 建议 12，给 pg 留余量。
OPS_DB_MAX_CONNS=12

# —— 系统管理账号 ——
# 永久超级管理员用户名（默认 skyeder）；密码见上面必改第 4 项。
# OPS_SYSTEM_ADMIN_USER=skyeder

# —— 采集与平台能力闸门（验收前保持关闭）——
# V4 采集部署开关：off（默认）/ allow。改 allow 后仍需超管在网页开启来源与强度；
# 小红书与公众号页面受 robots 限制，保持停用，不影响官方微信接口。
OPS_CRAWL_MODE=off
#
# Electron 本机 AI 总开关：0/false 关闭（默认），1/true 才启用，且仍需逐工作区授权。
OPS_DESKTOP_AI_ENABLED=0
#
# 桌面端平台采集（D-129/D-160）：0 = 进程层显式关闭（默认安全态，验收前保持 0）；空/1 = 放行进程闸，日常听超管 kill_switch。
# 修改后需重启 API 生效；关闭时客户端跳过心跳并在界面显示暂停提示（OPT-U06）。
OPS_DESKTOP_PLATFORM_ENABLED=0
#
# 自动采用闸门（DEV-PS62）：默认 0，正式验收通过前不要开；开 1 会把平台读数直接写进官方指标。
OPS_DESKTOP_PLATFORM_AUTO_ADOPT=0
#
# 智能体冻结特性开关（D-160，逗号列表，如 chrome_connect,context_refs）：
# 空 = 不额外放开任何键，以超管 DB 为准；默认全关。
OPS_AGENT_WORKBENCH_FEATURES=

# —— 可选：Cloudflare Tunnel ——
# 大陆公网 80/443 未备案被拦时，用 Tunnel 旁路；在 Zero Trust 建隧道后复制 token。
# 启动：docker compose -f deploy/docker-compose.lite.yml -f deploy/docker-compose.tunnel.yml \
#         --env-file deploy/.env.lite up -d cloudflared
# Tunnel 会把公网主机名转到 http://127.0.0.1:44537，需与 OPS_HOST_PORT 保持一致。
# CLOUDFLARE_TUNNEL_TOKEN=
